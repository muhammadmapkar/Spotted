{
  "expo": {
    "name": "Spotted",
    "slug": "spotted",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spotted",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spotted.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Spotted uses your location while the app is open, to show how far saved places are and to find places near you. Your location stays on your phone.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Spotted uses your location to tell you when a place you saved is nearby, even when the app is closed. Your location stays on your phone.",
        "NSLocationAlwaysUsageDescription": "Spotted uses your location to tell you when a place you saved is nearby, even when the app is closed. Your location stays on your phone.",
        "UIBackgroundModes": [
          "location"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8505B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.spotted.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200,
          "backgroundColor": "#5A189A",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#5A189A"
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Spotted uses your location to tell you when a place you saved is nearby, even when the app is closed. Your location stays on your phone.",
          "locationAlwaysPermission": "Spotted uses your location to tell you when a place you saved is nearby, even when the app is closed. Your location stays on your phone.",
          "locationWhenInUsePermission": "Spotted uses your location while the app is open, to show how far saved places are and to find places near you. Your location stays on your phone.",
          "motionUsagePermission": "Your phone may use motion information to save battery while Spotted watches for saved places near you. Spotted does not read or store it.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#6A1FB0"
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ShareExtension",
                  "bundleIdentifier": "com.spotted.app.share-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.spotted.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "02a504fa-29fc-40f8-8ccb-657b3654636a"
      }
    },
    "owner": "muhammadmapkar",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/02a504fa-29fc-40f8-8ccb-657b3654636a"
    }
  }
}
