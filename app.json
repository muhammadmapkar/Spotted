{
  "expo": {
    "name": "Spotted",
    "slug": "spotted",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spotted",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spotted.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Spotted uses your location while the app is open, to show how far saved places are and to find places near you. Your location stays on your phone.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Spotted uses your location to tell you when a place you saved is nearby, even when the app is closed. Your location stays on your phone.",
        "NSLocationAlwaysUsageDescription": "Spotted uses your location to tell you when a place you saved is nearby, even when the app is closed. Your location stays on your phone.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8505B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.spotted.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200,
          "backgroundColor": "#5A189A",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#5A189A"
          }
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Spotted uses your location to tell you when a place you saved is nearby, even when the app is closed. Your location stays on your phone.",
          "locationAlwaysPermission": "Spotted uses your location to tell you when a place you saved is nearby, even when the app is closed. Your location stays on your phone.",
          "locationWhenInUsePermission": "Spotted uses your location while the app is open, to show how far saved places are and to find places near you. Your location stays on your phone.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6A1FB0"
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*"
          ],
          "disableIOS": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3bc5968d-9f89-4752-9c9c-f91def153e27"
      }
    },
    "owner": "sarahnaziahmed-debug",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3bc5968d-9f89-4752-9c9c-f91def153e27"
    }
  }
}
