# Copy this file to .env and fill in your own values. Never commit .env.
#
# Option A (recommended for anything you give to other people): the address of your places proxy.
# See server/places-proxy/README.md. The Google key then stays on the server, not in the app.
EXPO_PUBLIC_PLACES_PROXY_URL=

# Option B (only for your own testing): a Google key used directly by the app.
# Ignored when the proxy address above is set.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
